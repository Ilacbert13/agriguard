APP_NAME=AGRIGUARD
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.example
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=warning (or error) to reduce noise
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (create database `agriguard` in MySQL before migrating, or switch
# to sqlite and set DB_DATABASE to the absolute path of database/database.sqlite)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agriguard
DB_USERNAME=root
DB_PASSWORD=
# DB_SOCKET=
#
# Render.com (MySQL private service): set DB_CONNECTION=mysql, DB_HOST, DB_PORT=3306,
# DB_DATABASE, DB_USERNAME, DB_PASSWORD (see render.yaml Blueprint). Leave APP_URL unset
# to use RENDER_EXTERNAL_URL. Set APP_KEY (php artisan key:generate --show).

# Sessions: use database on Render (ephemeral disk; survives restarts; works with multiple instances).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave null unless you use a custom domain cookie policy. Wrong DOMAIN is a common 419 cause.
SESSION_DOMAIN=null
# Local: omit or false. Production (Render HTTPS): set true, or omit — APP_ENV=production defaults secure cookies on.
# SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — local: MAIL_MAILER=log (OTP/emails in laravel.log).
# Production (Resend): MAIL_MAILER=resend + RESEND_API_KEY (installed via Composer on deploy).
# SMTP: MAIL_MAILER=smtp + MAIL_HOST / MAIL_USERNAME / MAIL_PASSWORD.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
# RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Third-party APIs (optional — weather and AI features degrade gracefully when unset)
# -----------------------------------------------------------------------------
OPENWEATHERMAP_API_KEY=

TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-20b
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_FALLBACK_MODELS=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Weather ML (Python venv at repo root — Dockerfile creates .venv + pip install).
# Defaults: Windows .venv\Scripts\python.exe | Linux/macOS .venv/bin/python
# Override only if Python lives elsewhere:
# -----------------------------------------------------------------------------
# AGRIWEATHER_PYTHON_BIN=
# AGRIWEATHER_PREDICT_SCRIPT=
# AGRIWEATHER_MODEL_PATH=
# AGRIWEATHER_PREDICT_TIMEOUT=45
# AGRIWEATHER_PREDICT_CACHE_MINUTES=15

# Flood risk barangay listings cache (Farm Map initial payload); clear with historical CSV import partial flush or php artisan cache:clear
# BARANGAY_FLOOD_OVERVIEW_CACHE_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
